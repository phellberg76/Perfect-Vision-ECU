[Unit]
Description=Planter BLE Bridge - UART to HTTP proxy for ESP32
After=network.target tomcat.service
Wants=tomcat.service

[Service]
Type=simple
ExecStart=/usr/local/bin/planter-ble-bridge --uart --port /dev/ttyAMA0 --backend http://localhost:8080/planter_app
Restart=always
RestartSec=5
User=root

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=planter-ble-bridge

# Give time for serial port to be available
ExecStartPre=/bin/sleep 2

[Install]
WantedBy=multi-user.target
